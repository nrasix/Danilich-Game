    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041C\u041E\u041B\u041E\u0414\u0415\u0426 \u0422\u042B \u041F\u0420\u041E\u0428\u0415\u041B
    \u0423\u0416\u0415 2 \u041C\u0418\u0421\u0421\u0418\u0418\n\n\u0412 \u0414\u0410\u041D\u041D\u041E\u0419
    \u041C\u0418\u0421\u0421\u0418\u0418 \u0422\u0415\u0411\u0415 \u041D\u0423\u0416\u041D\u041E
    \u0411\u0423\u0414\u0415\u0422 \u0414\u041E\u0419\u0422\u0418 \u0416\u0418\u0412\u042B\u041C\n\u0414\u041E
    \u041C\u0410\u0413\u0410\u0417\u0418\u041D\u0410 \"ARCADE\"\n\n\u041E\u041D \u041D\u0410\u0425\u041E\u0414\u0418\u0422\u0421\u042F
    \u0412\u041E\u0417\u041B\u0415 \u0424\u041E\u041D\u0422\u0410\u041D\u0410\n\n\u0423\u0414\u0410\u0427\u0418
    \u0421\u041E\u041B\u0414\u0410\u0422!\n\n\n\n\n\n\n\n\u041D\u0410\u0416\u041C\u0418\u0422\u0415
    \"ESC\" \u0427\u0422\u041E\u0411\u042B \u0417\u0410\u041A\u0420\u042B\u0422\u042C
    \u0414\u0410\u041D\u041D\u041E\u0415 \u0421\u041E\u041E\u0411\u0429\u0415\u041D\u0418\u0415"

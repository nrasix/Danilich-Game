    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0422\u042B \u041C\u041E\u041B\u041E\u0414\u0415\u0426! \u042D\u0422\u041E
    \u0422\u0412\u041E\u042F \u041F\u041E\u0421\u041B\u0415\u0414\u041D\u042F\u042F
    \u041C\u0418\u0421\u0421\u0418\u042F\n\n\u0412 \u0414\u0410\u041D\u041D\u041E\u0419
    \u041C\u0418\u0421\u0421\u0418\u0418 \u0422\u0415\u0411\u0415 \u041D\u0423\u0416\u041D\u041E
    \u0411\u0423\u0414\u0415\u0422 \u0414\u041E\u0419\u0422\u0418 \u0416\u0418\u0412\u042B\u041C\n\u0414\u041E
    \u0417\u0410\u041F\u0420\u0410\u0412\u041A\u0418\n\n\u041E\u041D\u0410 \u041D\u0410\u0425\u041E\u0414\u0418\u0422\u0421\u042F
